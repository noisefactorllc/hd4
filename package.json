{
  "name": "hd4",
  "version": "0.1.0",
  "description": "Four-channel software video mixer for the open web. Broadcast-style switcher with an integrated audio mixer, built on Noisemaker and WebAudio.",
  "type": "module",
  "author": "Noise Factor LLC",
  "license": "MIT",
  "keywords": [
    "video-mixer",
    "switcher",
    "noisemaker",
    "webgl",
    "webaudio",
    "shaders"
  ],
  "scripts": {
    "dev": "http-server . -p 3014 -c-1",
    "test": "node --test 'tests/unit/**/*.test.js'",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "test:e2e": "playwright test",
    "lint": "find js -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
